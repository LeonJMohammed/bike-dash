// Shared build settings for Debug and Release.
// Machine-specific values (team ID, Spotify client ID) live in Secrets.xcconfig,
// which exists only on the Mac (copy Secrets.example.xcconfig).

// Git commit shown in the app. The build script passes the real one.
BIKEDASH_COMMIT = dev

// Empty unless Secrets.xcconfig sets it; the Music page then says "not set up".
SPOTIFY_CLIENT_ID =

#include? "Secrets.xcconfig"
