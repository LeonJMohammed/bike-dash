<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install-agents.sh fills in __REPO__ and __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jlmoh.bikedash.agent</string>
	<key>ProgramArguments</key>
	<array>
		<!-- caffeinate keeps the Mac from idling to sleep mid-build. -->
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/bash</string>
		<string>__REPO__/scripts/agent.sh</string>
	</array>
	<!-- Requests from the PC. -->
	<key>QueueDirectories</key>
	<array>
		<string>__HOME__/.config/bike-dash/queue</string>
	</array>
	<!-- Every 15 minutes, on the quarter hour: each run checks Tailscale
	     (agent.sh), and refresh.sh decides whether to re-sign. That's once in
	     each evening hour, 20:00 to 23:00 (20:00 with three retries), or every
	     run through the night before it expires; at any other time it does
	     nothing, so launchd catching up at a morning wake can't re-sign or
	     alert. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>45</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/bike-dash/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/bike-dash/launchd.log</string>
</dict>
</plist>
