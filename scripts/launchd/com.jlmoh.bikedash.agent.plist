<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install-agents.sh fills in __REPO__ and __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jlmoh.bikedash.agent</string>
	<key>ProgramArguments</key>
	<array>
		<!-- caffeinate keeps the Mac from idling to sleep mid-build. -->
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/bin/bash</string>
		<string>__REPO__/scripts/agent.sh</string>
	</array>
	<!-- Requests from the PC. -->
	<key>QueueDirectories</key>
	<array>
		<string>__HOME__/.config/bike-dash/queue</string>
	</array>
	<!-- The re-sign check, evenings only: 20:00, then 21:00, 22:00 and 23:00
	     as retries. launchd runs a slot missed while the Mac slept when it
	     wakes; refresh.sh ignores that (and a login) outside 20:00 to
	     midnight, so a morning wake waits for the next evening. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>20</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>21</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>22</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>23</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/bike-dash/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/bike-dash/launchd.log</string>
</dict>
</plist>
