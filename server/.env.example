# Copy to server/.env on the home PC (git-ignored). Read by spotify-token-service.js.

# Spotify developer dashboard > Bike Dash > Settings: the same Client ID as the app's
# Secrets.xcconfig, and the Client secret ("View client secret"). The secret stays on this PC.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Encrypts the refresh token the app keeps: 32 random bytes, base64. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A new key signs Bike Dash out of Spotify (its saved refresh token no longer opens), and
# retires the routes app key too.
TOKEN_KEY=

# Strava routes (strava-routes.js): borrows Race Tracker's Strava token over localhost.
# The same random value as BIKE_DASH_SECRET in race-tracker\.env.
RACE_TRACKER_SECRET=
# The app key's id. `node server/spotify-token-service.js mint-routes-key` adds it if missing
# and prints a key for the Mac's Secrets.xcconfig (BIKE_DASH_ROUTES_KEY). A new value retires
# every key minted before it.
# ROUTES_KEY_ID=

# Optional. Must match the redirect URI in the Spotify dashboard and the app.
# SPOTIFY_REDIRECT_URI=bikedash://spotify-login-callback
# PORT=3010
# RACE_TRACKER_TOKEN_URL=http://127.0.0.1:3003/race-tracker/api/strava/token
