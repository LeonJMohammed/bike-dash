# Copy to server/.env on the home PC (git-ignored). Read by spotify-token-service.js.

# Spotify developer dashboard > Bike Dash > Settings: the same Client ID as the app's
# Secrets.xcconfig, and the Client secret ("View client secret"). The secret stays on this PC.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Encrypts the refresh token the app keeps: 32 random bytes, base64. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# A new key signs Bike Dash out of Spotify (its saved refresh token no longer opens).
TOKEN_KEY=

# Optional. Must match the redirect URI in the Spotify dashboard and the app.
# SPOTIFY_REDIRECT_URI=bikedash://spotify-login-callback
# PORT=3010
